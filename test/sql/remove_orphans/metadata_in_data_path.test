# name: test/sql/remove_orphans/metadata_in_data_path.test
# description: ducklake_delete_orphaned_files should not delete the metadata database when it resides in the data path
# group: [remove_orphans]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata_in_data_path_metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS fixture_metadata;
UPDATE fixture_metadata.ducklake_schema SET path='test/main/' WHERE catalog_id=0;
DETACH fixture_metadata;

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}', METADATA_CATALOG 'ducklake_metadata', CATALOG_ID 0);

statement ok
USE ducklake

statement ok
CREATE TABLE metadata_in_data_path_tbl (a integer)

statement ok
INSERT INTO metadata_in_data_path_tbl VALUES (1);

statement ok
CALL ducklake_flush_inlined_data('ducklake')

# The metadata DB and the parquet data file must exist before the call
query I
SELECT count(*) FROM GLOB('{DATA_PATH}/metadata_in_data_path_*.db')
----
1

query I
SELECT count(*) FROM GLOB('{DATA_PATH}/**/metadata_in_data_path_tbl/*.parquet')
----
1

statement ok
CALL ducklake_delete_orphaned_files('ducklake', cleanup_all => true);

# Verify the metadata DB file was NOT deleted
query I
SELECT count(*) FROM GLOB('{DATA_PATH}/metadata_in_data_path_*.db')
----
1

# Verify the parquet data file was NOT deleted
query I
SELECT count(*) FROM GLOB('{DATA_PATH}/**/metadata_in_data_path_tbl/*.parquet')
----
1
