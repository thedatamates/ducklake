# name: test/sql/general/metadata_parameters.test
# description: Test attach with metadata parameters
# group: [general]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_metadata_parameters

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_metadata_parameters', META_TYPE 'DUCKDB', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.tbl AS FROM range(1000) t(i);

query I
SELECT COUNT(*) FROM ducklake.tbl
----
1000

statement error
ATTACH 'ducklake:{DATA_PATH}/ducklake_metadata_parametersxx.db' AS s (DATA_PATH '{DATA_PATH}/ducklake_metadata_parameters', META_TYPE 'DUCKDBXX', CATALOG_ID 0);
----
duckdbxx
