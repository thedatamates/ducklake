# name: test/sql/general/database_size.test
# description: test ducklake extension
# group: [general]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_database_size_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_database_size_files', METADATA_CATALOG 'ducklake_meta', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER, j INTEGER);

statement ok
INSERT INTO ducklake.test SELECT i, i + 100 FROm range(1000) t(i);

statement ok
PRAGMA database_size

query I
SELECT database_size <> '0 bytes' FROM PRAGMA_database_size() WHERE database_name='ducklake'
----
true
