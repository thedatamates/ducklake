# name: test/sql/alter/rename_column_with_case_insensitive_name.test
# description: test ducklake column rename with case insensitive name
# group: [alter]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_promote_type_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_promote_type_files', METADATA_CATALOG 'xx', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test("MyCol" INT);

statement ok
ALTER TABLE ducklake.test RENAME COLUMN mycol to newname;
