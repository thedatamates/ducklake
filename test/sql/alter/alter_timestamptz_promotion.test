# name: test/sql/alter/alter_timestamptz_promotion.test
# description: test ducklake timestamp to timestamptz promotion
# group: [alter]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

statement ok
SET TimeZone='UTC';

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/alter_timestamptz_promotion

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/alter_timestamptz_promotion', CATALOG_ID 0);

statement ok
SET timezone='UTC'

statement ok
CREATE TABLE ducklake.test(col1 TIMESTAMP);

statement ok
INSERT INTO ducklake.test VALUES ('2025-01-15 12:30:45'::TIMESTAMP)

statement ok
ALTER TABLE ducklake.test ALTER COLUMN col1 TYPE TIMESTAMPTZ;

statement ok
INSERT INTO ducklake.test VALUES ('2025-01-15 12:30:45'::TIMESTAMPTZ)

query I
FROM ducklake.test
----
2025-01-15 12:30:45+00
2025-01-15 12:30:45+00
