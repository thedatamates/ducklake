# name: test/sql/reserved_names/reserved_names.test
# description: test using reserved names fails gracefully
# group: [reserved_names]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/colname

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/colname', DATA_INLINING_ROW_LIMIT 20, CATALOG_ID 0);

statement error
CREATE TABLE ducklake.conflict(id INTEGER, _ducklake_internal_snapshot_id INTEGER);
----
Column name "_ducklake_internal_snapshot_id" is reserved by DuckLake for internal use
