# name: test/sql/default/struct_field_default.test
# description: Test adding a struct field with default values
# group: [default]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_struct_default_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_struct_default_files', METADATA_CATALOG 'xx', CATALOG_ID 0);


statement ok
CREATE TABLE ducklake.test(col1 STRUCT(i INT, j INT));

statement ok
INSERT INTO ducklake.test VALUES ({'i': 1, 'j': 2})

# add k INTEGER
statement ok
BEGIN

statement ok
ALTER TABLE ducklake.test ADD COLUMN col1.k INTEGER DEFAULT 42

statement ok
INSERT INTO ducklake.test VALUES ({'i': 100, 'j': 200, 'k': 300})

query I
FROM ducklake.test
----
{'i': 1, 'j': 2, 'k': 42}
{'i': 100, 'j': 200, 'k': 300}

statement ok
COMMIT

query I
FROM ducklake.test
----
{'i': 1, 'j': 2, 'k': 42}
{'i': 100, 'j': 200, 'k': 300}
