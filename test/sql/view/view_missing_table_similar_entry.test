# name: test/sql/view/view_missing_table_similar_entry.test
# description: Test that querying views with missing table references does not stack overflow
# group: [view]

require ducklake

require parquet

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/view_missing_table.db,main,{TEST_DIR}/view_missing_table

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{TEST_DIR}/view_missing_table.db' AS ducklake (DATA_PATH '{TEST_DIR}/view_missing_table', CATALOG_ID 0);

statement ok
use ducklake

# lets make a table
statement ok
CREATE TABLE my_table (a INTEGER, b VARCHAR)

# bunch of views can select from it
loop i 0 10

statement ok
CREATE VIEW view_{i} AS FROM ducklake.main.my_table

endloop

# unbound views by deatch attach
statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{TEST_DIR}/view_missing_table.db' AS ducklake (DATA_PATH '{TEST_DIR}/view_missing_table', CATALOG_ID 0);

# drop the table before binding
statement ok
DROP TABLE ducklake.main.my_table

# this would stack overflow since we cant bind ze table
query I
SELECT count(*) FROM information_schema.tables WHERE table_catalog = 'ducklake'
----
10
