# name: test/sql/view/ducklake_view_table_conflict.test
# description: test ducklake view/table conflicts
# group: [view]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_view_conflict_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_view_conflict_files', CATALOG_ID 0);

# create a view
statement ok
CREATE VIEW ducklake.v1 AS SELECT 42

statement error
DROP TABLE IF EXISTS ducklake.v1
----
trying to drop type Table

statement error
CREATE OR REPLACE TABLE ducklake.v1(i INTEGER)
----
trying to replace with type Table
