# name: test/sql/cloud/test_cloud_cases.test
# description: test ducklake extension
# group: [cloud]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/test_cloud_cases/

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/test_cloud_cases/', METADATA_CATALOG 'metadata', CATALOG_ID 0);

statement ok
use lake;

statement ok
CREATE TABLE test AS FROM range (10) t(i);

statement ok
START;

statement ok
DELETE FROM test where i = 1;

statement ok
DELETE FROM test where i = 2;

statement ok
COMMIT;

query I
select * from test order by all;
----
0
3
4
5
6
7
8
9