# name: test/sql/rowid/ducklake_row_id_update.test
# description: test ducklake row-id tracking over partition and updates
# group: [rowid]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_row_id_update_2

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_row_id_update_2', METADATA_CATALOG 'ducklake_meta', CATALOG_ID 0);

statement ok
USE ducklake;

statement ok
CREATE OR REPLACE TABLE test(i INTEGER, j INTEGER);

statement ok
ALTER TABLE test SET PARTITIONED BY (i);

statement ok
INSERT INTO test VALUES (1,5), (2,5)

statement ok
MERGE INTO test
    USING (
        SELECT
            1 as i,
            5 as j
    ) AS test_updates
    ON test.j = test_updates.j
    WHEN MATCHED THEN UPDATE;

query III
SELECT rowid,i,j FROM test order by rowid
----
0	1	5
1	1	5