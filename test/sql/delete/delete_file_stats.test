# name: test/sql/delete/delete_file_stats.test
# description: Test ducklake delete stats
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/delete_file_stats

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/delete_file_stats', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test AS SELECT i id FROM range(2000) t(i);

statement ok
INSERT INTO ducklake.test SELECT i id FROM range(15000, 16000) t(i)

query I
DELETE FROM ducklake.test WHERE id%2=0
----
1500

query II
SELECT  file_size_bytes > 0, footer_size >= 0 FROM __ducklake_metadata_ducklake.ducklake_delete_file
----
true	true
true	true
