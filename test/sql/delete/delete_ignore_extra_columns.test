# name: test/sql/delete/delete_ignore_extra_columns.test
# description: Test ducklake deletes
# group: [delete]

require ducklake

require parquet

unzip data/iceberg_deletes/delete_ignore_extra_columns.db.gz {TEST_DIR}/legacy_delete_fixture.db

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/delete_ignore_extra_columns.db,main,data/iceberg_deletes/delete_ignore_extra_columns

include test/fixtures/managed_catalog.sql

endloop

# Keep the original Parquet/delete files and their metadata, in the managed format.
statement ok
ATTACH '{TEST_DIR}/legacy_delete_fixture.db' AS legacy (READ_ONLY);
ATTACH '{TEST_DIR}/delete_ignore_extra_columns.db' AS managed;
INSERT INTO managed.ducklake_snapshot SELECT * FROM legacy.ducklake_snapshot WHERE snapshot_id>0;
INSERT INTO managed.ducklake_table BY NAME SELECT 0 AS catalog_id, * FROM legacy.ducklake_table;
INSERT INTO managed.ducklake_column BY NAME SELECT 0 AS catalog_id, * FROM legacy.ducklake_column;
INSERT INTO managed.ducklake_data_file BY NAME SELECT 0 AS catalog_id, * EXCLUDE(partial_file_info) FROM legacy.ducklake_data_file;
INSERT INTO managed.ducklake_delete_file BY NAME SELECT 0 AS catalog_id, * FROM legacy.ducklake_delete_file;
INSERT INTO managed.ducklake_table_stats BY NAME SELECT 0 AS catalog_id, * FROM legacy.ducklake_table_stats;
INSERT INTO managed.ducklake_table_column_stats BY NAME SELECT 0 AS catalog_id, * FROM legacy.ducklake_table_column_stats;
INSERT INTO managed.ducklake_schema_versions VALUES (0, 1, 1, 1);
INSERT INTO managed.ducklake_snapshot_changes VALUES (0, 1, 'created_table:"main"."test"', NULL, NULL, NULL), (0, 2, 'deleted_from_table:1', NULL, NULL, NULL);
INSERT INTO managed.ducklake_snapshot_lineage VALUES (0, 0, 1), (0, 1, 2);
DETACH legacy;
DETACH managed;

statement ok
ATTACH 'ducklake:{TEST_DIR}/delete_ignore_extra_columns.db' AS ducklake (DATA_PATH 'data/iceberg_deletes/delete_ignore_extra_columns', OVERRIDE_DATA_PATH TRUE, CATALOG_ID 0);

statement ok
use ducklake

query I
SELECT count(*) from test;
----
91
