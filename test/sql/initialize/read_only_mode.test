# name: test/sql/initialize/read_only_mode.test
# description: test ducklake on realy only mode
# group: [initialize]

require ducklake

require parquet

statement ok
ATTACH '{TEST_DIR}/read_only_mode.db' AS db1

statement ok
DETACH db1;

statement error
ATTACH 'ducklake:{TEST_DIR}/read_only_mode.db' AS ducklake (CATALOG_ID 0, READONLY 1, CREATE_IF_NOT_EXISTS false)
----
metadata must be provisioned

statement error
ATTACH 'ducklake:{TEST_DIR}/read_only_mode.db' AS ducklake (CATALOG_ID 0, READONLY 1)
----
metadata must be provisioned

statement error
ATTACH 'ducklake:{TEST_DIR}/read_only_mode.db' AS ducklake (CATALOG_ID 0, READONLY 1, CREATE_IF_NOT_EXISTS true)
----
metadata must be provisioned

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/provisioned.db,main,{TEST_DIR}/data

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{TEST_DIR}/provisioned.db' AS lake (CATALOG_ID 0);
CREATE TABLE lake.items AS SELECT 42 AS id;
DETACH lake;
ATTACH 'ducklake:{TEST_DIR}/provisioned.db' AS lake (CATALOG_ID 0, READ_ONLY);

query I
SELECT * FROM lake.items;
----
42

statement error
INSERT INTO lake.items VALUES (43);
----
read-only
