# name: test/sql/functions/ducklake_table_info.test
# group: [functions]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_table_info_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_table_info_files', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER)

statement ok
INSERT INTO ducklake.test FROM range(1000)

statement ok
DELETE FROM ducklake.test WHERE i%2=0

query IIIIIII
SELECT table_name, schema_id, table_id, file_count, file_size_bytes > 0, delete_file_count, delete_file_size_bytes > 0 FROM ducklake.table_info();
----
test	0	1	1	true	1	true
