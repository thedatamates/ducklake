# name: test/sql/data_inlining/inlining_unsupported_systems.test
# description: test ducklake updating
# group: [data_inlining]

require ducklake

require parquet

# partitioning based on a column
test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/inlining_unsupported_systems

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/inlining_unsupported_systems', METADATA_CATALOG 'ducklake_metadata', CATALOG_ID 0);


statement maybe
CALL ducklake.set_option('data_inlining_row_limit', '10');
----
Data Inlining is currently only implemented for DuckDB as a DBMS

