# name: test/sql/data_inlining/inlining_double.test
# description: test ducklake inlining with double values
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/inlining_double

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}'  AS ducklake (DATA_PATH '{DATA_PATH}/inlining_double', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10, CATALOG_ID 0);

statement ok
USE ducklake;

statement ok
CREATE TABLE events (id INTEGER, latitude DOUBLE, longitude DOUBLE)

statement ok
INSERT INTO events VALUES (1, 37.7749, -122.4194)

query III
FROM events;
----
1	37.7749	-122.4194