# name: test/sql/data_inlining/data_inlining_constraints.test
# description: test data inlining with NOT NULL constraints
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_inlining_constraint_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_inlining_constraint_files', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10, CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER, j INTEGER NOT NULL);

statement error
INSERT INTO ducklake.test VALUES (42, NULL)
----
NOT NULL constraint failed
