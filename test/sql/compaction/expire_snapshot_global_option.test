# name: test/sql/compaction/expire_snapshot_global_option.test
# description: Test global options for the inlining function ducklake_expire_snapshots
# group: [compaction]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/expire_snapshot_global_option

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/expire_snapshot_global_option', CATALOG_ID 0);

# delete all values in a table
# snapshot 1
statement ok
CREATE TABLE ducklake.test(i INTEGER)

# snapshot 2
statement ok
INSERT INTO ducklake.test FROM range(10)

statement ok
CALL ducklake.set_option('expire_older_than', '1 millisecond')

query I
SELECT count(*) FROM ducklake_expire_snapshots('ducklake', dry_run => true)
----
2

statement ok
CALL ducklake.set_option('expire_older_than', '1 week')

query I
SELECT count(*) FROM ducklake_expire_snapshots('ducklake', dry_run => true)
----
0

query I
SELECT count(*) FROM ducklake_expire_snapshots('ducklake', dry_run => true, versions => [1])
----
1