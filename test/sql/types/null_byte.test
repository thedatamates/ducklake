# name: test/sql/types/null_byte.test
# description: Test null bytes in strings
# group: [types]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_null_byte

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_null_byte', METADATA_CATALOG 'ducklake_meta', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.tbl(s VARCHAR);

statement ok
INSERT INTO ducklake.tbl VALUES ('goo' || chr(0) || 'se'), ('hello');

query I
FROM ducklake.tbl
----
goo\0se
hello

query I
FROM ducklake.tbl WHERE s < 'hello'
----
goo\0se
