# name: test/sql/multi_catalog/aliases.test
# description: Aliases preserve schema ownership and keep catalogs readable through their changes
# group: [multi_catalog]

require ducklake

require parquet

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/aliases.db,main,{TEST_DIR}/data

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{TEST_DIR}/aliases.db' AS lake (CATALOG_ID 0, DATA_INLINING_ROW_LIMIT 0);
CREATE TABLE lake.seed AS SELECT 1 AS id;
CREATE SCHEMA lake.documents;
CREATE TABLE lake.documents.seed AS SELECT 1 AS id;
DROP TABLE lake.documents.seed;
INSERT INTO __ducklake_metadata_lake.ducklake_snapshot
SELECT max(snapshot_id) + 1, now(), max(schema_version), max(next_catalog_id), max(next_file_id)
FROM __ducklake_metadata_lake.ducklake_snapshot;
INSERT INTO __ducklake_metadata_lake.ducklake_alias
SELECT 0, 1000, uuid(), (SELECT max(snapshot_id) FROM __ducklake_metadata_lake.ducklake_snapshot), NULL, schema_id, 'revenue', 'table', 0, 0, 'seed'
FROM __ducklake_metadata_lake.ducklake_schema WHERE schema_name='documents';
INSERT INTO __ducklake_metadata_lake.ducklake_snapshot_changes
SELECT 0, max(snapshot_id), 'created_alias:"documents"."revenue",updated_alias:1000,discarded_alias:1000', NULL, NULL, NULL
FROM __ducklake_metadata_lake.ducklake_snapshot;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='lake' AND schema_name='documents';
----
0

# Snapshot listings and later commits parse the alias changes.
query I
SELECT count(*) > 0 FROM ducklake_snapshots('lake');
----
true

statement ok
INSERT INTO lake.seed VALUES (2);

query I
SELECT sum(id) FROM lake.seed;
----
3

statement error
DROP SCHEMA lake.documents CASCADE;
----
discard them through Crucible

# A discarded alias, whose current revision has no source, does not own its schema.
statement ok
UPDATE __ducklake_metadata_lake.ducklake_alias SET end_snapshot=(SELECT max(snapshot_id) FROM __ducklake_metadata_lake.ducklake_snapshot);
INSERT INTO __ducklake_metadata_lake.ducklake_alias
SELECT 0, 1000, uuid(), (SELECT max(snapshot_id) FROM __ducklake_metadata_lake.ducklake_snapshot), NULL, schema_id, 'revenue', NULL, NULL, NULL, NULL
FROM __ducklake_metadata_lake.ducklake_schema WHERE schema_name='documents';
DROP SCHEMA lake.documents;

statement ok
DETACH lake;
ATTACH '{TEST_DIR}/aliases.db' AS inspect;
UPDATE inspect.ducklake_metadata SET value='1.1-dev1-catalog2' WHERE key='version' AND catalog_id IS NULL;
DETACH inspect;

statement error
ATTACH 'ducklake:{TEST_DIR}/aliases.db' AS old (CATALOG_ID 0);
----
requires Crucible metadata version 1.1-dev1-catalog3
