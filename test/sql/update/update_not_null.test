# name: test/sql/update/update_not_null.test
# description: test updating a table with a NOT NULL constraint
# group: [update]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_update_not_null_files

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_update_not_null_files', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER NOT NULL, j INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (42, NULL);

statement ok
BEGIN

statement error
UPDATE ducklake.test SET i=NULL
----
NOT NULL constraint failed

statement error
UPDATE ducklake.test SET i=100
----
Current transaction is aborted

statement ok
ROLLBACK

query II
FROM ducklake.test
----
42	NULL
