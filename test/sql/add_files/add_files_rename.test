# name: test/sql/add_files/add_files_rename.test
# description: test ducklake adding files with rename
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_add_files_rename

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_add_files_rename', CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

# write a parquet file outside of DuckLake
statement ok
COPY (SELECT 100 col1, 'world' col2) TO '{DATA_PATH}/rename_file.parquet';

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '{DATA_PATH}/rename_file.parquet')

query II
SELECT col1, col2 FROM ducklake.test
----
100	world

statement ok
ALTER TABLE ducklake.test RENAME col1 TO new_col

query II
SELECT new_col, col2 FROM ducklake.test
----
100	world
