# name: test/sql/macros/test_schema_dependency.test
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/test_schema_dependency

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/test_schema_dependency', CATALOG_ID 0);

statement ok
use ducklake

statement ok
CREATE SCHEMA test;

statement ok
CREATE MACRO test.simple(a) AS a;

statement ok
CREATE TABLE test.test_tbl (id INT, name string);

statement ok
CREATE MACRO test.xt(a,_name) as TABLE SELECT * FROM test.test_tbl WHERE(id>=a or name=_name);

# Check Macro Tables
# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro;
----
0	1	2	simple	2	NULL
0	1	4	xt	4	NULL

statement ok
DROP SCHEMA test CASCADE;

# Check Macro Tables
# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro;
----
0	1	2	simple	2	5
0	1	4	xt	4	5