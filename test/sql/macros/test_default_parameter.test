# name: test/sql/macros/test_default_parameter.test
# description: test macro with a default parameter
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/test_default_parameter

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/test_default_parameter', CATALOG_ID 0);

statement ok
use ducklake

statement ok
CREATE MACRO add_default(a, b := 5) AS a + b;

# Check Macro Tables
# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro;
----
0	0	1	add_default	1	NULL

# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro_impl;
----
0	1	0	duckdb	(a + b)	scalar

# Metadata rows are scoped by catalog_id.
query IIIIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro_parameters;
----
0	1	0	0	a	unknown	NULL	unknown
0	1	0	1	b	unknown	5	int32

query I
select add_default(1)
----
6

query I
select add_default(1,3)
----
4

statement ok
CREATE MACRO add_default_sec(a :=5) AS a;

query I
select add_default_sec('a')
----
a

query I
select add_default_sec()
----
5