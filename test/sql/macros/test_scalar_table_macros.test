# name: test/sql/macros/test_scalar_table_macros.test
# description: test table macros
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/test_defined_types

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/test_defined_types', CATALOG_ID 0);

statement ok
USE ducklake;

statement ok
CREATE TABLE test_tbl (id INT, name string);

statement ok
INSERT INTO test_tbl VALUES (1,'tom'), (2,'dick'),(3,'harry'), (4,'mary'), (5,'mungo'), (6,'midge');

statement ok
CREATE MACRO xt(a,_name) as TABLE SELECT * FROM test_tbl WHERE(id>=a or name=_name);

statement ok
CREATE MACRO xt(a) as 1;

# Check Macro Tables
# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro;
----
0	0	2	xt	3	NULL
0	0	3	xt	4	NULL

# Metadata rows are scoped by catalog_id.
query IIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro_impl;
----
0	2	0	duckdb	SELECT * FROM test_tbl WHERE ((id >= a) OR ("name" = _name))	table
0	3	0	duckdb	1	scalar


# Metadata rows are scoped by catalog_id.
query IIIIIIII
FROM __ducklake_metadata_ducklake.ducklake_macro_parameters;
----
0	2	0	0	a	unknown	NULL	unknown
0	2	0	1	_name	unknown	NULL	unknown
0	3	0	0	a	unknown	NULL	unknown

query II
FROM xt(5,'tom');
----
1	tom
5	mungo
6	midge

query I
SELECT xt(1)
----
1

statement error
CREATE MACRO xt(a,_name) as TABLE SELECT * FROM test_tbl WHERE(id>=a or name=_name);
----
Table Macro Function with name "xt" already exists

statement error
CREATE MACRO xt(a) as 1;
----
Macro Function with name "xt" already exists