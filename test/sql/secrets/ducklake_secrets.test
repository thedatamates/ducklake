# name: test/sql/secrets/ducklake_secrets.test
# description: Test DuckLake connections with secrets
# group: [secrets]

require ducklake

require parquet

# no secret available
statement error
ATTACH 'ducklake:' AS ducklake (CATALOG_ID 0)
----
Default secret was not found

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/metadata.db,main,{TEST_DIR}/my_data_path

include test/fixtures/managed_catalog.sql

endloop

# default secret
statement ok
CREATE SECRET (
	TYPE DUCKLAKE,
	METADATA_PATH '{TEST_DIR}/metadata.db',
	DATA_PATH '{TEST_DIR}/my_data_path'
);

statement ok
ATTACH 'ducklake:' AS ducklake (CATALOG_ID 0)

statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (1), (2), (3);

# flush inlined data to create files
statement ok
CALL ducklake_flush_inlined_data('ducklake')

# verify we are using the correct path
query I
SELECT COUNT(*) FROM glob('{TEST_DIR}/my_data_path/**/*.parquet')
----
1

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:' AS ducklake (CATALOG_ID 0)

query I
FROM ducklake.test
----
1
2
3

statement ok
DETACH ducklake

# named secrets
statement ok
CREATE SECRET my_ducklake (
	TYPE DUCKLAKE,
	METADATA_PATH '{TEST_DIR}/metadata_named.db',
	DATA_PATH '{TEST_DIR}/my_data_path_named'
);

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/metadata_named.db,main,{TEST_DIR}/my_data_path_named

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:my_ducklake' AS ducklake(CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (1), (2), (3);

# flush inlined data to create files
statement ok
CALL ducklake_flush_inlined_data('ducklake')

# verify we are using the correct path
query I
SELECT COUNT(*) FROM glob('{TEST_DIR}/my_data_path_named/**/*.parquet')
----
1

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:my_ducklake' AS ducklake(CATALOG_ID 0);

query I
FROM ducklake.test
----
1
2
3

statement ok
DETACH ducklake

# named secrets with path-like names
statement ok
CREATE SECRET "tenant/ducklake" (
	TYPE DUCKLAKE,
	METADATA_PATH '{TEST_DIR}/metadata_named_slash.db',
	DATA_PATH '{TEST_DIR}/my_data_path_named_slash'
);

foreach fixture_path,fixture_schema,fixture_data_path {TEST_DIR}/metadata_named_slash.db,main,{TEST_DIR}/my_data_path_named_slash

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:tenant/ducklake' AS ducklake(CATALOG_ID 0);

statement ok
CREATE TABLE ducklake.test(i INTEGER);

statement ok
INSERT INTO ducklake.test VALUES (1), (2), (3);

# flush inlined data to create files
statement ok
CALL ducklake_flush_inlined_data('ducklake')

# verify a path-like secret name resolves the secret instead of becoming a metadata path
query I
SELECT COUNT(*) FROM glob('{TEST_DIR}/my_data_path_named_slash/**/*.parquet')
----
1

statement ok
DETACH ducklake

# a secret with the same name but a different type must not be loaded as a DuckLake secret
statement ok
CREATE SECRET wrong_type_ducklake (
	TYPE HTTP,
	BEARER_TOKEN 'token'
);

statement error
ATTACH 'ducklake:wrong_type_ducklake' AS wrong_type_ducklake(CATALOG_ID 0);
----
Secret "wrong_type_ducklake" was not found

# metadata parameters
statement ok
CREATE SECRET metadata_parameters123 (
	TYPE DUCKLAKE,
	METADATA_PATH '{TEST_DIR}/metadata_named.db',
	DATA_PATH '{TEST_DIR}/my_data_path_named',
	METADATA_PARAMETERS MAP {'TYPE': 'DUCKDBXX'}
);

statement error
ATTACH 'ducklake:metadata_parameters123' AS ducklake(CATALOG_ID 0);
----
duckdbxx

# unknown secret name
statement error
ATTACH 'ducklake:unknown_secret' AS ducklake(CATALOG_ID 0);
----
Secret "unknown_secret" was not found
