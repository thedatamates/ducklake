# name: test/sql/checkpoint/view_checkpoint.test
# description: Test checkpoint with a view
# group: [checkpoint]

require ducklake

require parquet

require icu

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/view_checkpoint/

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/view_checkpoint/', CATALOG_ID 0);

statement ok
use ducklake

statement ok
create table t (a integer, b integer, c integer)

statement ok
create view v as select a from t;

statement ok
CHECKPOINT;