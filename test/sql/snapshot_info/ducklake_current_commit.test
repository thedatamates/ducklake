# name: test/sql/snapshot_info/ducklake_current_commit.test
# description: test that the ducklake_current_snapshot returns current snapshot id
# group: [snapshot_info]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/metadata.db

test-env DATA_PATH {TEST_DIR}

foreach fixture_path,fixture_schema,fixture_data_path {DUCKLAKE_CONNECTION},main,{DATA_PATH}/ducklake_current_snapshot_commit

include test/fixtures/managed_catalog.sql

endloop

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_current_snapshot_commit', CATALOG_ID 0);

statement ok
USE ducklake;

query I
FROM ducklake_current_snapshot('ducklake')
----
0

# Snapshot 1
statement ok
CREATE TABLE integer(i INTEGER);

query I
FROM ducklake_current_snapshot('ducklake')
----
1

# Start a few transactions
statement ok con1
BEGIN TRANSACTION

statement ok con2
BEGIN TRANSACTION

statement ok con3
BEGIN TRANSACTION

# Each transaction does somethins
statement ok con1
CREATE TABLE ducklake.integers_2(i INTEGER)

statement ok con1
INSERT into ducklake.integers_2 values (0);

statement ok con2
INSERT into ducklake.integer values (0);

statement ok con3
INSERT into ducklake.integer  values (1);

# Snapshot still 1
query I
FROM ducklake_current_snapshot('ducklake')
----
1

# Check commited snapshot from within a transaction
query I con1
FROM ducklake_current_snapshot('ducklake')
----
1

statement ok con1
COMMIT

query I
FROM ducklake_current_snapshot('ducklake')
----
2

statement ok con2
ROLLBACK

query I
FROM ducklake_current_snapshot('ducklake')
----
2

statement ok con3
COMMIT

query I
SELECT id > 2 AND id = (SELECT max(snapshot_id) FROM ducklake_snapshots('ducklake')) FROM ducklake_current_snapshot('ducklake');
----
true

# Try out the macro
query I
SELECT id > 2 AND id = (SELECT max(snapshot_id) FROM ducklake_snapshots('ducklake')) FROM current_snapshot();
----
true